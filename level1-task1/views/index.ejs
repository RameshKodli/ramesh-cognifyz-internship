<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Task 1 - HTML Structure & Basic Server Interaction</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1>Level 1 - Task 1</h1>
    <h2>Contact / Feedback Form</h2>

    <form action="/submit" method="POST" class="user-form">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required placeholder="Your full name">

      <label for="email">Email</label>
      <input type="email" id="email" name="email" required placeholder="you@example.com">

      <label for="message">Message</label>
      <textarea id="message" name="message" rows="4" required placeholder="Say something..."></textarea>

      <button type="submit">Submit</button>
    </form>

    <% if (submitted) { %>
      <div class="result">
        <h3>Thanks, <%= submitted.name %>!</h3>
        <p>We received your message and rendered this confirmation server-side using EJS.</p>
        <ul>
          <li><strong>Email:</strong> <%= submitted.email %></li>
          <li><strong>Message:</strong> <%= submitted.message %></li>
          <li><strong>Submitted at:</strong> <%= submitted.submittedAt %></li>
        </ul>
      </div>
    <% } %>

    <p><a href="/submissions">View all submissions</a></p>
  </div>
</body>
</html>
